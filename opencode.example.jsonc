{
    "$schema": "https://opencode.ai/config.json",
    // Template for a local agent configuration. Copy to `opencode.jsonc` (git-ignored) and fill in
    // your own host and credentials; never commit the real file.
    "mcp": {
        "music-assistant": {
            "type": "remote",
            "url": "http://<music-assistant-host>:8095/mcp/v1",
            "enabled": true,
            "oauth": false,
            "headers": {
                // A local 0600 file containing `Bearer <long-lived MA token>`.
                "Authorization": "{file:/absolute/path/to/ma-mcp-auth}",
            },
        },
    },
}
